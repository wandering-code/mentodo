SECRET_KEY=cambia-esto-por-un-secreto-seguro
# Cuenta de administrador: se crea sola al arrancar si no existe todavía.
ADMIN_USERNAME=wander
ADMIN_PASSWORD=cambia-esto
# Web Push (notificaciones al móvil/PC). Generar con: docker compose exec backend python -m app.vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wanderingcode.dev
# true en producción (HTTPS vía Cloudflare): la cookie de sesión solo viaja cifrada
COOKIE_SECURE=false
